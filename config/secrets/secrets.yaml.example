# Quantum Trader AI - Secrets Configuration Example
# CRITICAL: This is an example file. DO NOT commit actual secrets to version control.
# Copy this file to secrets.yaml and fill in your actual values.
# Ensure secrets.yaml is in .gitignore

# Production deployment managing billions - Security is paramount
# All secrets should be:
# 1. Encrypted at rest
# 2. Rotated regularly (90 days max)
# 3. Accessed via environment variables or secret management service
# 4. Never logged or exposed in error messages

# =============================================================================
# EXCHANGE API CREDENTIALS
# =============================================================================

exchanges:
  binance:
    api_key: "${BINANCE_API_KEY}"
    api_secret: "${BINANCE_API_SECRET}"
    # Optional: For futures/margin trading
    futures_api_key: "${BINANCE_FUTURES_API_KEY}"
    futures_api_secret: "${BINANCE_FUTURES_API_SECRET}"
    # Passphrase for additional security (if supported)
    passphrase: "${BINANCE_PASSPHRASE}"
    # IP whitelist for API access (comma-separated)
    whitelisted_ips: "${BINANCE_WHITELISTED_IPS}"
    # Permissions: "readonly", "trade", "withdraw"
    permissions: "trade"

  bybit:
    api_key: "${BYBIT_API_KEY}"
    api_secret: "${BYBIT_API_SECRET}"
    testnet_api_key: "${BYBIT_TESTNET_API_KEY}"
    testnet_api_secret: "${BYBIT_TESTNET_API_SECRET}"
    passphrase: "${BYBIT_PASSPHRASE}"
    whitelisted_ips: "${BYBIT_WHITELISTED_IPS}"
    permissions: "trade"

  okx:
    api_key: "${OKX_API_KEY}"
    api_secret: "${OKX_API_SECRET}"
    passphrase: "${OKX_PASSPHRASE}"  # REQUIRED for OKX
    whitelisted_ips: "${OKX_WHITELISTED_IPS}"
    permissions: "trade"

  kucoin:
    api_key: "${KUCOIN_API_KEY}"
    api_secret: "${KUCOIN_API_SECRET}"
    passphrase: "${KUCOIN_PASSPHRASE}"  # REQUIRED for KuCoin
    whitelisted_ips: "${KUCOIN_WHITELISTED_IPS}"
    permissions: "trade"

  bitget:
    api_key: "${BITGET_API_KEY}"
    api_secret: "${BITGET_API_SECRET}"
    passphrase: "${BITGET_PASSPHRASE}"
    whitelisted_ips: "${BITGET_WHITELISTED_IPS}"
    permissions: "trade"

# =============================================================================
# DATABASE CREDENTIALS
# =============================================================================

database:
  # PostgreSQL primary database
  primary:
    host: "${DB_PRIMARY_HOST}"
    port: "${DB_PRIMARY_PORT}"
    database: "${DB_NAME}"
    username: "${DB_USERNAME}"
    password: "${DB_PASSWORD}"
    # SSL/TLS configuration
    ssl_mode: "${DB_SSL_MODE}"  # require, verify-ca, verify-full
    ssl_cert: "${DB_SSL_CERT_PATH}"
    ssl_key: "${DB_SSL_KEY_PATH}"
    ssl_root_cert: "${DB_SSL_ROOT_CERT_PATH}"

  # Read replicas
  replicas:
    - host: "${DB_REPLICA_01_HOST}"
      port: "${DB_REPLICA_01_PORT}"
      database: "${DB_NAME}"
      username: "${DB_REPLICA_USERNAME}"
      password: "${DB_REPLICA_PASSWORD}"
      ssl_mode: "${DB_SSL_MODE}"

    - host: "${DB_REPLICA_02_HOST}"
      port: "${DB_REPLICA_02_PORT}"
      database: "${DB_NAME}"
      username: "${DB_REPLICA_USERNAME}"
      password: "${DB_REPLICA_PASSWORD}"
      ssl_mode: "${DB_SSL_MODE}"

  # Backup database
  backup:
    host: "${DB_BACKUP_HOST}"
    port: "${DB_BACKUP_PORT}"
    database: "${DB_BACKUP_NAME}"
    username: "${DB_BACKUP_USERNAME}"
    password: "${DB_BACKUP_PASSWORD}"

# =============================================================================
# REDIS / CACHE CREDENTIALS
# =============================================================================

redis:
  # Redis cluster configuration
  cluster:
    nodes:
      - host: "${REDIS_NODE_01_HOST}"
        port: "${REDIS_NODE_01_PORT}"
      - host: "${REDIS_NODE_02_HOST}"
        port: "${REDIS_NODE_02_PORT}"
      - host: "${REDIS_NODE_03_HOST}"
        port: "${REDIS_NODE_03_PORT}"
    password: "${REDIS_PASSWORD}"
    # TLS configuration
    ssl: "${REDIS_SSL_ENABLED}"
    ssl_cert_reqs: "${REDIS_SSL_CERT_REQS}"
    ssl_ca_certs: "${REDIS_SSL_CA_CERTS}"

  # Standalone Redis (for development)
  standalone:
    host: "${REDIS_HOST}"
    port: "${REDIS_PORT}"
    password: "${REDIS_PASSWORD}"
    db: "${REDIS_DB}"

# =============================================================================
# NOTIFICATION SERVICES
# =============================================================================

notifications:
  # Email (SMTP)
  email:
    smtp_host: "${SMTP_HOST}"
    smtp_port: "${SMTP_PORT}"
    smtp_username: "${SMTP_USERNAME}"
    smtp_password: "${SMTP_PASSWORD}"
    smtp_use_tls: "${SMTP_USE_TLS}"
    from_address: "${EMAIL_FROM_ADDRESS}"

  # Telegram
  telegram:
    bot_token: "${TELEGRAM_BOT_TOKEN}"
    chat_id: "${TELEGRAM_CHAT_ID}"
    # For critical alerts
    admin_chat_id: "${TELEGRAM_ADMIN_CHAT_ID}"

  # Slack
  slack:
    webhook_url: "${SLACK_WEBHOOK_URL}"
    channel: "${SLACK_CHANNEL}"
    # OAuth token for advanced features
    oauth_token: "${SLACK_OAUTH_TOKEN}"

  # PagerDuty (for critical alerts)
  pagerduty:
    integration_key: "${PAGERDUTY_INTEGRATION_KEY}"
    api_key: "${PAGERDUTY_API_KEY}"

  # SMS (Twilio)
  sms:
    account_sid: "${TWILIO_ACCOUNT_SID}"
    auth_token: "${TWILIO_AUTH_TOKEN}"
    from_number: "${TWILIO_FROM_NUMBER}"
    to_numbers: "${TWILIO_TO_NUMBERS}"  # Comma-separated

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

monitoring:
  # Prometheus
  prometheus:
    basic_auth_username: "${PROMETHEUS_USERNAME}"
    basic_auth_password: "${PROMETHEUS_PASSWORD}"

  # Grafana
  grafana:
    admin_username: "${GRAFANA_ADMIN_USERNAME}"
    admin_password: "${GRAFANA_ADMIN_PASSWORD}"
    api_key: "${GRAFANA_API_KEY}"
    # OAuth configuration
    oauth_client_id: "${GRAFANA_OAUTH_CLIENT_ID}"
    oauth_client_secret: "${GRAFANA_OAUTH_CLIENT_SECRET}"

  # Datadog (optional)
  datadog:
    api_key: "${DATADOG_API_KEY}"
    app_key: "${DATADOG_APP_KEY}"

  # Sentry (error tracking)
  sentry:
    dsn: "${SENTRY_DSN}"
    auth_token: "${SENTRY_AUTH_TOKEN}"
    organization: "${SENTRY_ORGANIZATION}"
    project: "${SENTRY_PROJECT}"

# =============================================================================
# CLOUD SERVICES
# =============================================================================

cloud:
  # AWS
  aws:
    access_key_id: "${AWS_ACCESS_KEY_ID}"
    secret_access_key: "${AWS_SECRET_ACCESS_KEY}"
    region: "${AWS_REGION}"
    # S3 backup bucket
    s3_backup_bucket: "${AWS_S3_BACKUP_BUCKET}"
    # KMS key for encryption
    kms_key_id: "${AWS_KMS_KEY_ID}"

  # Google Cloud Platform
  gcp:
    project_id: "${GCP_PROJECT_ID}"
    # Path to service account JSON
    credentials_path: "${GCP_CREDENTIALS_PATH}"
    # Storage bucket for backups
    storage_bucket: "${GCP_STORAGE_BUCKET}"

  # Azure (if applicable)
  azure:
    subscription_id: "${AZURE_SUBSCRIPTION_ID}"
    tenant_id: "${AZURE_TENANT_ID}"
    client_id: "${AZURE_CLIENT_ID}"
    client_secret: "${AZURE_CLIENT_SECRET}"

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================

security:
  # JWT token secrets
  jwt:
    secret_key: "${JWT_SECRET_KEY}"
    refresh_secret_key: "${JWT_REFRESH_SECRET_KEY}"
    algorithm: "${JWT_ALGORITHM}"

  # API authentication
  api:
    # Internal service-to-service authentication
    internal_api_key: "${INTERNAL_API_KEY}"
    # External API key for third-party integrations
    external_api_key: "${EXTERNAL_API_KEY}"

  # Encryption keys (for sensitive data at rest)
  encryption:
    master_key: "${ENCRYPTION_MASTER_KEY}"
    # Data encryption key (encrypted by master key)
    data_key: "${ENCRYPTION_DATA_KEY}"

  # SSL/TLS certificates
  ssl:
    cert_path: "${SSL_CERT_PATH}"
    key_path: "${SSL_KEY_PATH}"
    ca_bundle_path: "${SSL_CA_BUNDLE_PATH}"

# =============================================================================
# WEBHOOK ENDPOINTS
# =============================================================================

webhooks:
  # TradingView alerts
  tradingview:
    secret: "${TRADINGVIEW_WEBHOOK_SECRET}"

  # Custom webhooks
  custom:
    endpoint_01:
      url: "${CUSTOM_WEBHOOK_01_URL}"
      secret: "${CUSTOM_WEBHOOK_01_SECRET}"

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================

backup:
  # Encryption key for backups
  encryption_key: "${BACKUP_ENCRYPTION_KEY}"
  # Remote backup credentials
  remote:
    type: "${BACKUP_REMOTE_TYPE}"  # s3, gcs, azure, ftp
    host: "${BACKUP_REMOTE_HOST}"
    username: "${BACKUP_REMOTE_USERNAME}"
    password: "${BACKUP_REMOTE_PASSWORD}"
    path: "${BACKUP_REMOTE_PATH}"

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

integrations:
  # CoinGecko API
  coingecko:
    api_key: "${COINGECKO_API_KEY}"

  # CoinMarketCap API
  coinmarketcap:
    api_key: "${COINMARKETCAP_API_KEY}"

  # News API
  news_api:
    api_key: "${NEWS_API_KEY}"

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# Production overrides
production:
  # Additional production-only secrets
  vault:
    url: "${VAULT_URL}"
    token: "${VAULT_TOKEN}"
    namespace: "${VAULT_NAMESPACE}"

# Staging overrides
staging:
  # Use separate credentials for staging
  # (structure same as production)

# Development overrides
development:
  # Use test credentials for development
  # (structure same as production)

# =============================================================================
# NOTES
# =============================================================================
#
# Security Best Practices:
# 1. Use environment variables for all secrets (${VAR_NAME} format)
# 2. Never commit this file with actual values to git
# 3. Rotate all credentials every 90 days
# 4. Use different credentials for each environment
# 5. Enable IP whitelisting on all exchange APIs
# 6. Use read-only API keys where possible
# 7. Enable 2FA on all exchange accounts
# 8. Store encryption keys in a hardware security module (HSM) or key vault
# 9. Use SSL/TLS for all connections
# 10. Audit access to secrets regularly
#
# Environment Variables:
# Load secrets from environment using:
#   - .env file (development only, never commit)
#   - CI/CD secrets (GitHub Actions, GitLab CI, etc.)
#   - Secret management service (AWS Secrets Manager, HashiCorp Vault, etc.)
#   - Kubernetes secrets (for containerized deployments)
#
# =============================================================================
