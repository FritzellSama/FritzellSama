# =============================================================================
# QUANTUM TRADER AI - ENVIRONMENT CONFIGURATION
# =============================================================================
# CRITICAL: This is a template file. Copy to .env and fill with actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false
TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL (Primary Database)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quantum_trader
POSTGRES_USER=quantum_trader
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# PostgreSQL Connection Pool
POSTGRES_POOL_MIN_SIZE=10
POSTGRES_POOL_MAX_SIZE=50
POSTGRES_POOL_TIMEOUT=30

# Redis (Caching & Message Queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_POOL_MAX_CONNECTIONS=100

# TimescaleDB (Time-series Data)
TIMESCALE_ENABLED=true

# -----------------------------------------------------------------------------
# Exchange API Keys
# -----------------------------------------------------------------------------
# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=false

# Bybit
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=false

# OKX
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_TESTNET=false

# KuCoin
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_API_SECRET=your_kucoin_api_secret_here
KUCOIN_PASSPHRASE=your_kucoin_passphrase_here
KUCOIN_TESTNET=false

# Bitget
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here
BITGET_TESTNET=false

# -----------------------------------------------------------------------------
# Trading Configuration
# -----------------------------------------------------------------------------
# Global Trading Limits
MAX_POSITION_SIZE_USD=100000
MAX_LEVERAGE=10
MAX_DAILY_LOSS_USD=50000
MAX_DRAWDOWN_PERCENT=20

# Order Execution
ORDER_TIMEOUT_SECONDS=30
ORDER_RETRY_MAX_ATTEMPTS=3
ORDER_RETRY_DELAY_SECONDS=2

# Risk Management
RISK_CHECK_ENABLED=true
RISK_EMERGENCY_STOP_ENABLED=true
RISK_VAR_CONFIDENCE=0.95

# -----------------------------------------------------------------------------
# Notification Configuration
# -----------------------------------------------------------------------------
# Notification Manager
NOTIFICATION_MAX_QUEUE_SIZE=1000
NOTIFICATION_NUM_WORKERS=3
NOTIFICATION_HEALTH_CHECK_INTERVAL=60
NOTIFICATION_RETRY_DELAY_BASE=2
NOTIFICATION_RETRY_DELAY_MAX=300
NOTIFICATION_ENABLE_RATE_LIMITING=true
NOTIFICATION_SHUTDOWN_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX_PER_MINUTE=100
RATE_LIMIT_GLOBAL_MAX_PER_HOUR=1000
RATE_LIMIT_TELEGRAM_MAX_PER_MINUTE=20
RATE_LIMIT_TELEGRAM_BURST_SIZE=5
RATE_LIMIT_EMAIL_MAX_PER_MINUTE=10
RATE_LIMIT_EMAIL_BURST_SIZE=3
RATE_LIMIT_SLACK_MAX_PER_MINUTE=30
RATE_LIMIT_SLACK_BURST_SIZE=10
RATE_LIMIT_WEBHOOK_MAX_PER_MINUTE=50
RATE_LIMIT_WEBHOOK_BURST_SIZE=15
RATE_LIMIT_SMS_MAX_PER_MINUTE=5
RATE_LIMIT_SMS_BURST_SIZE=2
RATE_LIMIT_USER_MAX_PER_MINUTE=30
RATE_LIMIT_USER_BURST_SIZE=10
RATE_LIMIT_CLEANUP_INTERVAL=300
RATE_LIMIT_BUCKET_TTL=3600

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_DELAY_BASE=2
TELEGRAM_RETRY_DELAY_MAX=60
TELEGRAM_TIMEOUT_SECONDS=30
TELEGRAM_MAX_MESSAGE_LENGTH=4096
TELEGRAM_PARSE_MODE=Markdown
TELEGRAM_DISABLE_WEB_PREVIEW=true

# Email (SMTP)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM_ADDRESS=quantum-trader@example.com
EMAIL_FROM_NAME=Quantum Trader AI
EMAIL_DEFAULT_TO=alerts@example.com

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#trading-alerts

# SMS (Twilio)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890

# Webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com/api/alerts

# Report Templates
REPORT_CURRENCY_SYMBOL=$
REPORT_DECIMAL_PLACES=2
REPORT_TIMEZONE=UTC
REPORT_DATE_FORMAT=%Y-%m-%d %H:%M:%S UTC
REPORT_INCLUDE_FOOTER=true
REPORT_FOOTER_TEXT=Quantum Trader AI - Institutional Trading Platform

# Trade Templates
TRADE_CURRENCY_SYMBOL=$
TRADE_DECIMAL_PLACES=2
TRADE_QUANTITY_PLACES=8
TRADE_DATE_FORMAT=%Y-%m-%d %H:%M:%S UTC
TRADE_INCLUDE_FOOTER=true
TRADE_FOOTER_TEXT=Quantum Trader AI
TRADE_INCLUDE_EXCHANGE=true
TRADE_INCLUDE_STRATEGY=true

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
API_ACCESS_LOG=true

# CORS
API_CORS_ENABLED=true
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Authentication
API_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_KEY
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRE_MINUTES=60

# Rate Limiting (API)
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Machine Learning Configuration
# -----------------------------------------------------------------------------
# Model Paths
ML_MODEL_DIR=/app/models
ML_CHECKPOINT_DIR=/app/checkpoints

# Training
ML_BATCH_SIZE=256
ML_LEARNING_RATE=0.001
ML_EPOCHS=100
ML_EARLY_STOPPING_PATIENCE=10

# Inference
ML_INFERENCE_BATCH_SIZE=512
ML_MODEL_UPDATE_INTERVAL_HOURS=24

# GPU
ML_USE_GPU=true
ML_GPU_DEVICE=0

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Metrics Export
METRICS_ENABLED=true
METRICS_PORT=9091
METRICS_PATH=/metrics

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# Data Collection & Storage
# -----------------------------------------------------------------------------
# Market Data Collection
DATA_COLLECTION_ENABLED=true
DATA_COLLECTION_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT
DATA_COLLECTION_TIMEFRAMES=1m,5m,15m,1h,4h,1d
DATA_COLLECTION_BUFFER_SIZE=10000

# Historical Data
DATA_HISTORICAL_START_DATE=2020-01-01
DATA_HISTORICAL_DOWNLOAD_BATCH_SIZE=1000

# Data Retention
DATA_RETENTION_RAW_DAYS=30
DATA_RETENTION_AGGREGATED_DAYS=365

# -----------------------------------------------------------------------------
# Backtesting Configuration
# -----------------------------------------------------------------------------
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION_RATE=0.001
BACKTEST_SLIPPAGE_RATE=0.0005

# -----------------------------------------------------------------------------
# Strategy Configuration
# -----------------------------------------------------------------------------
# Strategy paths are loaded from config/strategies/*.yaml
STRATEGY_CONFIG_DIR=/app/config/strategies
STRATEGY_AUTO_START=false

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Encryption
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_ENCRYPTION_KEY
ENCRYPTION_ALGORITHM=AES-256-GCM

# API Key Rotation
API_KEY_ROTATION_DAYS=90
API_KEY_ROTATION_WARNING_DAYS=7

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=/app/logs/audit.log

# -----------------------------------------------------------------------------
# Performance Tuning
# -----------------------------------------------------------------------------
# Async Workers
ASYNC_WORKER_POOL_SIZE=100
ASYNC_MAX_CONCURRENT_REQUESTS=1000

# Connection Timeouts
HTTP_TIMEOUT_SECONDS=30
WEBSOCKET_TIMEOUT_SECONDS=60
DATABASE_TIMEOUT_SECONDS=10

# Caching
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=10000

# -----------------------------------------------------------------------------
# Docker & Deployment
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=quantum_trader
DOCKER_NETWORK=quantum_trader_network

# Container Resources
BOT_MEMORY_LIMIT=4g
BOT_CPU_LIMIT=2
ML_MEMORY_LIMIT=8g
ML_CPU_LIMIT=4
DASHBOARD_MEMORY_LIMIT=2g
DASHBOARD_CPU_LIMIT=1

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
# Only enable in development
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_PROFILING=false
ENABLE_MOCK_EXCHANGES=false

# Testing
TEST_MODE=false
TEST_DATABASE_URL=postgresql://test:test@localhost:5433/quantum_trader_test
